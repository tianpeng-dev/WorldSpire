# 本机 PostgreSQL 或 Neon PostgreSQL；Neon 地址保留服务商提供的 TLS 参数。
POSTGRES_URL=postgresql://localhost:5432/wordspire
BETTER_AUTH_URL=http://localhost:3000
# 分别生成独立随机值：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
CRON_SECRET=

DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# 保留原有 SESSION_SECRET 才能升级有效的 ws_session；新项目可以留空。
SESSION_SECRET=

# 可选的外部服务；LLM 地址使用兼容 OpenAI Chat Completions 的 API 根地址。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
BLOB_READ_WRITE_TOKEN=
FCM_SERVER_KEY=

# 独立 PostgreSQL 16 测试环境，需要创建数据库的权限。
TEST_DATABASE_URL=postgresql://localhost:5432/wordspire_test
