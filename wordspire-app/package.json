{
  "name": "wordspire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "description": "词灵塔 WordSpire · 面向 4-11 岁儿童的游戏化英语学习平台",
  "scripts": {
    "dev": "tsx scripts/run.ts dev",
    "dev:ui": "NEXT_PUBLIC_DEMO_MODE=true tsx scripts/run.ts dev",
    "build": "tsx scripts/run.ts build",
    "start": "tsx scripts/run.ts start",
    "lint": "eslint src scripts tests --no-cache",
    "test:unit": "tsx --test tests/domain.test.ts tests/foundation.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:integration:production": "tsx scripts/test-integration.ts --production",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@next/env": "15.5.25",
    "@vercel/functions": "^2.0.0",
    "@vercel/blob": "^0.25.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.2",
    "fast-json-stable-stringify": "2.1.0",
    "pg": "^8.16.0",
    "pino": "^9.0.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.0",
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "tsx": "^4.20.0",
    "fetch-cookie": "^3.1.0",
    "tough-cookie": "^5.1.0",
    "@apidevtools/swagger-parser": "^10.1.0"
  }
}
